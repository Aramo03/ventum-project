# Local Django (runserver / manage.py). Copy to .env — optional: defaults in
# settings.py already use SQLite if this file is missing.
#
#   copy .env.example .env
#
DEBUG=True
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Wave 1–N: SQLite (no PostgreSQL install required)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=ventum.sqlite3

# Final project phase — PostgreSQL (see docs/postgresql.md):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ventum_db
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change_me
DEFAULT_FROM_EMAIL=Ventum <noreply@example.com>

# Wave B3 — shop inbox after a paid Idram order (docs/order-email.md).
# Change this when the shop address changes. Do not hardcode it in Python.
ORDER_NOTIFY_EMAIL=aram1023aram@gmail.com

# Wave B3 — Idram (docs/idram.md). Leave secrets empty in git.
# Real keys only in the local .env / server .env, never in a commit.
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
IDRAM_PAYMENT_URL=https://web.idram.am/payment.aspx
IDRAM_LANGUAGE=RU
