# Leave empty to call /api on this dev server (Vite proxies it to Django).
# Set http://127.0.0.1:8000 only if you want the browser to call Django directly.
VITE_BASE_URL=

# Google sign-in. Same Web client id as GOOGLE_CLIENT_ID on the API.
# Authorized JavaScript origins must include both Vite origins:
# http://127.0.0.1:3000 and http://localhost:3000.
# No client secret is required. Leave empty to hide the Google button
# and skip the Google script. Do not commit a real client id.
VITE_GOOGLE_CLIENT_ID=
